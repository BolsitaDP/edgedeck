#include <windows.h>
#include "Resource.h"
#include "Version.h"

// Application icon, shown in Explorer, the taskbar and the notification area. A numeric id (see
// Resource.h): the lowest-numbered icon is the one Explorer shows for the .exe.
IDI_EDGEDECK ICON "EdgeDeck.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    EDGEDECK_VERSION_NUMBERS
PRODUCTVERSION EDGEDECK_VERSION_NUMBERS
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "EdgeDeck"
            VALUE "FileVersion",     EDGEDECK_VERSION_STRING ".0"
            VALUE "InternalName",    "EdgeDeck"
            VALUE "OriginalFilename","EdgeDeck.exe"
            VALUE "ProductName",     "EdgeDeck"
            VALUE "ProductVersion",  EDGEDECK_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
